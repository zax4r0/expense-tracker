{
  "name": "expence-tracker",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --tunnle",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "lint": "eslint --ext \".ts,.js,.vue\" --ignore-path .eslintignore .",
    "lintfix": "eslint --fix --ext \".ts,.js,.vue\" --ignore-path .eslintignore .",
    "clean": "rm -rf .nuxt dist .output",
    "format": "prettier .prettierrc --write .",
    "tunnel": "npx expo start --tunnel",
    "build:release": "npx expo run:android --variant release",
    "ts:check": "tsc"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.2",
    "@expo/webpack-config": "~19.0.1",
    "@react-native-community/netinfo": "11.3.1",
    "@react-navigation/native": "^6.0.2",
    "@tanstack/react-query": "^4.32.6",
    "axois": "^0.0.1-security",
    "expo": "^51.0.22",
    "expo-font": "~12.0.9",
    "expo-linking": "~6.3.1",
    "expo-router": "~3.5.18",
    "expo-splash-screen": "~0.27.5",
    "expo-status-bar": "~1.12.1",
    "expo-system-ui": "~3.0.7",
    "expo-web-browser": "~13.0.3",
    "fp-ts": "^2.16.1",
    "immer": "^10.0.2",
    "lodash": "^4.17.21",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hook-form": "^7.45.4",
    "react-native": "0.74.3",
    "react-native-calendar-strip": "^2.2.6",
    "react-native-dimension": "^1.0.6",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-svg": "15.2.0",
    "react-native-web": "~0.19.10",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@commitlint/cli": "^17.2.0",
    "@commitlint/config-conventional": "^17.2.0",
    "@types/axios": "^0.14.0",
    "@types/lodash": "^4.14.196",
    "@types/react": "~18.2.79",
    "eslint": "^8.46.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^8.0.3",
    "jest": "^29.2.1",
    "jest-expo": "~51.0.3",
    "lint-staged": "^13.2.3",
    "prettier": "^3.0.1",
    "react-test-renderer": "18.2.0",
    "typescript": "~5.3.3"
  },
  "overrides": {
    "react-refresh": "~0.14.0"
  },
  "lint-staged": {
    "**/*.{js,ts,vue,html}": [
      "yarn lintfix"
    ]
  },
  "resolutions": {
    "react-refresh": "~0.14.0"
  },
  "private": true
}
